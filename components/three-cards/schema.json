{
  "name": "three-cards",
  "displayName": "Three Cards",
  "category": "card",
  "description": "用于展示三类方法、三种攻击、三个贡献点或三个挑战。",
  "suitableFor": ["taxonomy", "three methods", "three challenges", "three examples"],
