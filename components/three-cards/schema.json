      "minItems": 3,
      "maxItems": 3,
      "itemFields": {
        "title": { "type": "string", "required": true, "maxWords": 8 },
        "body": { "type": "string", "required": true, "maxWords": 40 },
        "icon": { "type": "string", "required": false }
      }
    }
  },
  "layoutLimits": {
    "minFontSize": 24,
    "maxPanels": 3,
    "allowImages": false,
    "allowTables": false,
    "allowNestedComponents": false
  },
  "exportRisk": "low"
}
