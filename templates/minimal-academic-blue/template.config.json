{
  "templateName": "minimal-academic-blue",
  "version": "0.1.0",
  "templateDir": "templates/minimal-academic-blue",
  "sourcePolicy": {
    "sourceDir": "templates/minimal-academic-blue/source",
    "manifestFile": "templates/minimal-academic-blue/source/template.source.json",
    "acceptedSourceTypes": ["pptx", "pdf", "png", "jpg", "jpeg"],
    "screenshotNaming": "page-XX-{slideType}.png",
    "notes": "HTML-native starter template."
  },
  "templateContract": {
    "mappingFile": "templates/minimal-academic-blue/template.mapping.json",
    "analysisFile": "templates/minimal-academic-blue/template.analysis.md",
    "lockedSlideTypes": ["cover", "agenda", "section", "content", "ending"],
    "fixedElementPolicy": "Fixed visual elements live in templates and CSS; generated deck data may only fill editable fields.",
    "dynamicContentPolicy": "Content slides may place generated content only inside [data-safe-area]."
  },
  "slideSize": {
    "width": 1920,
    "height": 1080,
    "aspectRatio": "16:9"
  },
  "slideTypes": {
    "cover": {
      "file": "templates/minimal-academic-blue/cover.html",
      "editableFields": ["kicker", "title", "subtitle", "author", "date"],
      "requiredPlaceholders": ["slideId", "kicker", "title", "subtitle", "author", "date"],
      "fixedElements": ["cover-bg", "cover-content", "cover-meta"],
      "dynamicRegions": ["cover-content", "cover-meta"],
      "fixedLayout": true
    },
    "agenda": {
      "file": "templates/minimal-academic-blue/agenda.html",
      "editableFields": ["kicker", "title", "items"],
      "requiredPlaceholders": ["slideId", "kicker", "title", "items", "deckTitle", "pageNumber"],
      "fixedElements": ["slide-header", "agenda-body", "slide-footer"],
      "dynamicRegions": ["agenda-list"],
      "fixedLayout": true,
      "maxItems": 6
    },
    "section": {
      "file": "templates/minimal-academic-blue/section.html",
      "editableFields": ["sectionNumber", "kicker", "title", "subtitle"],
      "requiredPlaceholders": ["slideId", "sectionNumber", "kicker", "title", "subtitle", "deckTitle", "pageNumber"],
      "fixedElements": ["section-index", "section-content", "slide-footer"],
      "dynamicRegions": ["section-content"],
      "fixedLayout": true
    },
    "content": {
      "file": "templates/minimal-academic-blue/content.html",
      "editableFields": ["section", "title", "layout", "content", "references"],
      "requiredPlaceholders": ["slideId", "section", "title", "content", "references", "deckTitle", "pageNumber"],
      "fixedElements": ["slide-header", "slide-body", "slide-references", "slide-footer"],
      "dynamicRegions": ["slide-body", "slide-references"],
      "fixedLayout": false,
      "safeArea": {
        "x": 96,
        "y": 232,
        "width": 1728,
        "height": 704
      }
    },
    "ending": {
      "file": "templates/minimal-academic-blue/ending.html",
      "editableFields": ["kicker", "title", "subtitle", "contact"],
      "requiredPlaceholders": ["slideId", "kicker", "title", "subtitle", "contact"],
      "fixedElements": ["ending-content", "ending-contact"],
      "dynamicRegions": ["ending-content", "ending-contact"],
      "fixedLayout": true
    }
  }
}
